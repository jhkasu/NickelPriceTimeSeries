movies_2000_2005 <- movies %>%
filter(year >= 2000 & year <= 2005)
# Now, calculate the average rating for each genre using this new, filtered data frame.
avg_ratings_2000s <- c(
Action      = mean(movies_2000_2005$rating[movies_2000_2005$Action == 1]),
Animation   = mean(movies_2000_2005$rating[movies_2000_2005$Animation == 1]),
Comedy      = mean(movies_2000_2005$rating[movies_2000_2005$Comedy == 1]),
Drama       = mean(movies_2000_2005$rating[movies_2000_2005$Drama == 1]),
Documentary = mean(movies_2000_2005$rating[movies_2000_2005$Documentary == 1]),
Romance     = mean(movies_2000_2005$rating[movies_2000_2005$Romance == 1]),
Short       = mean(movies_2000_2005$rating[movies_2000_2005$Short == 1])
)
# Print the resulting average ratings.
print(avg_ratings_2000s)
# We need the 'ggplot2' library for advanced plotting and 'tidyr' for reshaping data.
# If you haven't installed them, run install.packages(c("ggplot2", "tidyr")) in the console first.
library(ggplot2)
# Step 1: Filter movies from 1990 onwards and count movies per genre for each year.
genre_trends <- movies %>%
filter(year >= 1990) %>%
group_by(year) %>%
summarise(
Action = sum(Action),
Animation = sum(Animation),
Comedy = sum(Comedy),
Drama = sum(Drama),
Documentary = sum(Documentary),
Romance = sum(Romance),
.groups = 'drop' # This is good practice to avoid issues after summarising.
)
# Step 2: Reshape the data from a 'wide' to a 'long' format, which is ideal for ggplot2.
genre_trends_long <- genre_trends %>%
pivot_longer(
cols = -year,           # Pivot all columns except for the 'year' column.
names_to = "genre",     # The new column for the genre names will be called 'genre'.
values_to = "count"     # The new column for the movie counts will be called 'count'.
)
# Step 3: Create the plot using ggplot2.
ggplot(data = genre_trends_long, aes(x = year, y = count, color = genre)) +
geom_line(linewidth = 1) +  # Draw the lines, making them slightly thicker.
labs(
title = "Number of Movies Produced per Genre (1990-2005)",
x = "Year",
y = "Number of Movies",
color = "Genre" # This sets the title for the legend.
) +
theme_minimal() # Use a clean, minimal theme for the plot.
install.packages(c("ggplot2", "tidyr"))
