# --- Question 9.1: Average Budget by Genre ---
library(ggplot2)
library(scales)
movies_with_budget <- movies %>%
filter(!is.na(budget))
avg_budget_by_genre <- c(
Action      = mean(movies_with_budget$budget[movies_with_budget$Action == 1]),
Animation   = mean(movies_with_budget$budget[movies_with_budget$Animation == 1]),
Comedy      = mean(movies_with_budget$budget[movies_with_budget$Comedy == 1]),
Drama       = mean(movies_with_budget$budget[movies_with_budget$Drama == 1]),
Documentary = mean(movies_with_budget$budget[movies_with_budget$Documentary == 1]),
Romance     = mean(movies_with_budget$budget[movies_with_budget$Romance == 1])
)
avg_budget_df <- data.frame(
genre = names(avg_budget_by_genre),
avg_budget = avg_budget_by_genre
)
ggplot(avg_budget_df, aes(x = reorder(genre, -avg_budget), y = avg_budget)) +
geom_col(fill = "#0073C2FF") +
scale_y_continuous(labels = dollar_format(prefix = "$")) +
labs(
title = "Average Movie Budget by Genre",
x = "Genre",
y = "Average Budget"
) +
theme_minimal()
ggplot(avg_budget_df, aes(x = reorder(genre, -avg_budget), y = avg_budget)) +
geom_col(fill = "#0073C2FF") +
scale_y_continuous(labels = dollar_format(prefix = "$")) +
labs(
title = "Average Movie Budget by Genre",
x = "Genre",
y = "Average Budget"
) +
theme_minimal()
movies_with_decade <- movies %>%
mutate(decade = floor(year / 10) * 10)
genre_proportions_by_decade <- movies_with_decade %>%
select(decade, Action, Animation, Comedy, Drama, Documentary, Romance, Short) %>%
pivot_longer(
cols = -decade,
names_to = "genre",
values_to = "is_genre"
) %>%
filter(is_genre == 1) %>%
group_by(decade, genre) %>%
summarise(count = n(), .groups = 'drop')
ggplot(genre_proportions_by_decade, aes(x = factor(decade), y = count, fill = genre)) +
geom_col(position = "fill") +
scale_y_continuous(labels = percent) +
labs(
title = "Proportion of Movie Genres by Decade",
x = "Decade",
y = "Percentage of Total Movies in Decade",
fill = "Genre"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
avg_length_by_decade <- movies %>%
mutate(decade = floor(year / 10) * 10) %>%
filter(decade >= 1920) %>%
group_by(decade) %>%
summarise(avg_length = mean(length))
ggplot(avg_length_by_decade, aes(x = decade, y = avg_length)) +
geom_line(color = "navy", linewidth = 1) +
geom_point(color = "navy", size = 3) +
labs(
title = "Average Movie Length by Decade (1920-2000s)",
x = "Decade",
y = "Average Length (in minutes)"
) +
theme_minimal() +
scale_x_continuous(breaks = seq(1920, 2000, 10))
avg_length_no_shorts <- movies %>%
filter(Short == 0) %>%
mutate(decade = floor(year / 10) * 10) %>%
filter(decade >= 1920) %>%
group_by(decade) %>%
summarise(avg_length = mean(length))
ggplot(avg_length_no_shorts, aes(x = decade, y = avg_length)) +
geom_line(color = "green4", linewidth = 1) +
geom_point(color = "green4", size = 3) +
labs(
title = "Average Feature Film Length by Decade (Excluding 'Short' Genre)",
x = "Decade",
y = "Average Length (in minutes)"
) +
theme_minimal() +
scale_x_continuous(breaks = seq(1920, 2000, 10))
# --- Question 9.2: Average Length by Decade (Excluding Shorts) ---
avg_length_no_shorts <- movies %>%
filter(Short == 0) %>%
mutate(decade = floor(year / 10) * 10) %>%
filter(decade >= 1920) %>%
group_by(decade) %>%
summarise(avg_length = mean(length))
ggplot(avg_length_no_shorts, aes(x = decade, y = avg_length)) +
geom_line(color = "green4", linewidth = 1) +
geom_point(color = "green4", size = 3) +
labs(
title = "Average Feature Film Length by Decade (Excluding 'Short' Genre)",
x = "Decade",
y = "Average Length (in minutes)"
) +
theme_minimal() +
scale_x_continuous(breaks = seq(1920, 2000, 10))
# --- Question 9.3: Proportion of MPAA Ratings by Decade ---
# --- Question 9.3: Proportion of MPAA Ratings by Decade ---
# Filter for relevant ratings and create decade column
mpaa_trends <- movies %>%
filter(mpaa %in% c("G", "PG", "PG-13", "R")) %>%
mutate(decade = floor(year / 10) * 10) %>%
filter(decade >= 1940) %>%
group_by(decade, mpaa) %>%
summarise(count = n(), .groups = "drop")
# Ensure the MPAA levels are in a logical order for the plot legend
mpaa_trends$mpaa <- factor(mpaa_trends$mpaa, levels = c("G", "PG", "PG-13", "R"))
# Create the plot
ggplot(mpaa_trends, aes(x = factor(decade), y = count, fill = mpaa)) +
geom_col(position = "fill") +
scale_y_continuous(labels = percent) +
labs(
title = "Change in Proportion of MPAA Ratings by Decade",
x = "Decade",
y = "Percentage of Movies",
fill = "MPAA Rating"
) +
theme_minimal()
ggplot(mpaa_trends, aes(x = factor(decade), y = count, fill = mpaa)) +
geom_col(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Change in Proportion of MPAA Ratings by Decade",
x = "Decade",
y = "Percentage of Movies",
fill = "MPAA Rating"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
