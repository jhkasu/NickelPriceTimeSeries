.groups = 'drop' # This is good practice to avoid issues after summarising.
)
# Step 2: Reshape the data from a 'wide' to a 'long' format, which is ideal for ggplot2.
genre_trends_long <- genre_trends %>%
pivot_longer(
cols = -year,           # Pivot all columns except for the 'year' column.
names_to = "genre",     # The new column for the genre names will be called 'genre'.
values_to = "count"     # The new column for the movie counts will be called 'count'.
)
# Step 3: Create the plot using ggplot2.
ggplot(data = genre_trends_long, aes(x = year, y = count, color = genre)) +
