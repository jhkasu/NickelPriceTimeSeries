library(httr)       # For making API calls
library(jsonlite)   # For parsing JSON data
library(dplyr)      # For data manipulation
library(readr)      # For reading/writing CSV files
library(ggplot2)    # For plotting
# Load raw JSON
raw_data <- fromJSON("data/raw_nvda_data.json")
# Extract time series data
time_series_data <- raw_data$`Time Series (Daily)`
# Convert to data frame
df <- data.frame(
date = names(time_series_data),
do.call(rbind, time_series_data),
row.names = NULL
)
# Rename columns
df_cleaned <- df %>%
rename(
open = `X1..open`,
high = `X2..high`,
low = `X3..low`,
close = `X4..close`,
volume = `X5..volume`
)
# Convert data types and sort
df_final <- df_cleaned %>%
mutate(
date = as.Date(date),
open = as.numeric(open),
high = as.numeric(high),
low = as.numeric(low),
close = as.numeric(close),
volume = as.numeric(volume)
) %>%
arrange(date)
# Save to CSV
write_csv(df_final, "data/processed_nvda_data.csv")
# Display summary
cat("Dataset dimensions:", nrow(df_final), "rows and", ncol(df_final), "columns\n")
head(df_final)
summary(df_final)
# Define the split date
split_date <- as.Date("2024-06-10")
# Adjust pre-split prices
df_adjusted <- df_final %>%
mutate(
open = ifelse(date < split_date, open / 10, open),
high = ifelse(date < split_date, high / 10, high),
low = ifelse(date < split_date, low / 10, low),
close = ifelse(date < split_date, close / 10, close)
)
# Display adjusted summary
cat("Adjusted price range:\n")
cat("Min close:", min(df_adjusted$close), "\n")
cat("Max close:", max(df_adjusted$close), "\n")
summary(df_adjusted$close)
range(df_adjusted$close)
ggplot(df_adjusted, aes(x = date, y = close)) +
geom_line(color = "steelblue") +
scale_x_date(breaks = c(seq(as.Date("2000-01-01"), as.Date("2015-01-01"), by = "2 years"),
seq(as.Date("2016-01-01"), as.Date("2026-01-01"), by = "1 year")),
date_labels = "%Y") +
labs(title = "NVIDIA (NVDA) Adjusted Historical Closing Price",
x = "Date",
y = "Adjusted Closing Price (USD)") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Calculate daily returns
df_adjusted <- df_adjusted %>%
mutate(daily_return = (close - lag(close)) / lag(close))
# Calculate 30-day rolling volatility
df_adjusted <- df_adjusted %>%
mutate(volatility_30d = zoo::rollapply(daily_return,
width = 30,
FUN = sd,
fill = NA,
align = "right"))
# Plot volatility
ggplot(df_adjusted, aes(x = date, y = volatility_30d)) +
geom_line(color = "darkred") +
scale_x_date(breaks = c(seq(as.Date("2000-01-01"), as.Date("2015-01-01"), by = "2 years"),
seq(as.Date("2016-01-01"), as.Date("2026-01-01"), by = "1 year")),
date_labels = "%Y") +
labs(title = "NVIDIA (NVDA) 30-Day Rolling Volatility",
x = "Date",
y = "Volatility (Standard Deviation of Returns)") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(df_adjusted, aes(x = date, y = volume)) +
geom_line(color = "darkgreen") +
scale_x_date(breaks = c(seq(as.Date("2000-01-01"), as.Date("2015-01-01"), by = "2 years"),
seq(as.Date("2016-01-01"), as.Date("2026-01-01"), by = "1 year")),
date_labels = "%Y") +
scale_y_continuous(labels = scales::comma) +
labs(title = "NVIDIA (NVDA) Daily Trading Volume",
x = "Date",
y = "Volume") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Remove NA values from daily returns
returns_clean <- df_adjusted$daily_return[!is.na(df_adjusted$daily_return)]
# Create histogram with density overlay
ggplot(data.frame(returns = returns_clean), aes(x = returns)) +
geom_histogram(aes(y = after_stat(density)), bins = 50, fill = "steelblue", alpha = 0.7) +
geom_density(color = "darkred", linewidth = 1) +
labs(title = "Distribution of Daily Returns",
x = "Daily Return",
y = "Density") +
theme_minimal()
# Summary statistics
cat("Returns Summary Statistics:\n")
cat("Mean:", mean(returns_clean), "\n")
cat("Std Dev:", sd(returns_clean), "\n")
cat("Skewness:", moments::skewness(returns_clean), "\n")
cat("Kurtosis:", moments::kurtosis(returns_clean), "\n")
library(tseries)
# Perform ADF test on closing prices
adf_test <- adf.test(df_adjusted$close, alternative = "stationary")
cat("ADF Test Results:\n")
cat("Test Statistic:", adf_test$statistic, "\n")
cat("P-value:", adf_test$p.value, "\n")
if(adf_test$p.value < 0.05) {
cat("\nConclusion: The series is stationary (p < 0.05)\n")
} else {
cat("\nConclusion: The series is non-stationary (p >= 0.05)\n")
cat("Differencing will be required.\n")
}
# Apply first-order differencing
df_diff <- diff(df_adjusted$close)
# Test stationarity again
adf_test_diff <- adf.test(df_diff, alternative = "stationary")
cat("ADF Test Results (Differenced Series):\n")
cat("Test Statistic:", adf_test_diff$statistic, "\n")
cat("P-value:", adf_test_diff$p.value, "\n")
if(adf_test_diff$p.value < 0.05) {
cat("\nConclusion: The differenced series is stationary (p < 0.05)\n")
} else {
cat("\nConclusion: Further differencing may be required.\n")
}
par(mfrow = c(2, 1))
# ACF plot
acf(df_diff, main = "ACF of Differenced Series", lag.max = 40)
# PACF plot
pacf(df_diff, main = "PACF of Differenced Series", lag.max = 40)
par(mfrow = c(1, 1))
