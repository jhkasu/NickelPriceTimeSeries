```{r forecast_recursive}
# --- 1. Settings ---
n_forecast <- 12  # Forecast 12 months ahead
n_features <- 8    # 8 features
seq_len <- 18      

feature_names <- c("PNICKUSDM", "DTWEXBGS", "CPIAUCSL", "INDPRO", "DGS10", "PNICKUSDM_lag1", "PNICKUSDM_lag3", "PCOPPUSDM")

# --- 2. Prepare inputs and un-transform values ---
current_input_scaled <- tail(scaled, seq_len) %>%
  select(all_of(feature_names))

mean_val_log_diff <- mean(merged_stationary$PNICKUSDM, na.rm = TRUE)
sd_val_log_diff <- sd(merged_stationary$PNICKUSDM, na.rm = TRUE)
last_actual_price <- tail(merged_with_lags$PNICKUSDM, 1)

# --- 3. Recursive forecast loop ---
forecast_list_scaled <- list()
forecast_list_prices <- list()
current_last_price <- last_actual_price

for (i in 1:n_forecast) {
  # 3a. Format input for model
  input_for_model <- as.matrix(current_input_scaled) %>%
    array_reshape(c(1, seq_len, n_features))
  
  # 3b. Predict (t+i)
  pred_scaled_log_diff <- as.vector(model$predict(input_for_model))
  forecast_list_scaled[[i]] <- pred_scaled_log_diff
  
  # 3c. Un-transform prediction back to price
  pred_log_diff <- pred_scaled_log_diff * sd_val_log_diff + mean_val_log_diff
  predicted_price <- current_last_price * exp(pred_log_diff)
  
  forecast_list_prices[[i]] <- predicted_price
  current_last_price <- predicted_price # Update last price for next loop
  
  # --- 3d. Create new input row for next loop ---
  # Assumes all 7 external features remain constant
  last_known_features <- tail(current_input_scaled, 1)
  
  new_input_row <- data.frame(
    PNICKUSDM = pred_scaled_log_diff, # Use new prediction
    DTWEXBGS = last_known_features$DTWEXBGS,
    CPIAUCSL = last_known_features$CPIAUCSL,
    INDPRO = last_known_features$INDPRO,
    DGS10 = last_known_features$DGS10,
    PNICKUSDM_lag1 = last_known_features$PNICKUSDM,
    PNICKUSDM_lag3 = current_input_scaled$PNICKUSDM[seq_len - 2],
    PCOPPUSDM = last_known_features$PCOPPUSDM
  )
  
  # Roll the input window
  current_input_scaled <- rbind(tail(current_input_scaled, seq_len - 1), new_input_row)
}

# --- 4. Format and print forecast ---
last_date <- as.Date(tail(merged_stationary$observation_date, 1))
forecast_dates <- seq(from = (last_date %m+% months(1)), by = "month", length.out = n_forecast)

forecast_df <- data.frame(
  date = forecast_dates,
  forecasted_price = round(unlist(forecast_list_prices), 0)
)

print("--- 12-Month Recursive Forecast ---")
print(forecast_df)

# --- 5. Plot recursive forecast ---
ggplot(forecast_df, aes(x = date, y = forecasted_price)) +
  geom_line(color = "red", size = 1) +
  geom_point(color = "red", size = 2) +
  labs(
    title = "12-Month Recursive Forecast",
    x = "Forecast Date",
    y = "Predicted Nickel Price (USD)"
  ) +
  theme_minimal() +
  theme(plot.title = element_text(hjust = 0.5))
```