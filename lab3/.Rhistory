geom_line(color = "green4", linewidth = 1) +
geom_point(color = "green4", size = 3) +
labs(
title = "Average Feature Film Length by Decade (Excluding 'Short' Genre)",
x = "Decade",
y = "Average Length (in minutes)"
) +
theme_minimal() +
scale_x_continuous(breaks = seq(1920, 2000, 10))
# --- Question 9.3: Proportion of MPAA Ratings by Decade ---
# --- Question 9.3: Proportion of MPAA Ratings by Decade ---
# Filter for relevant ratings and create decade column
mpaa_trends <- movies %>%
filter(mpaa %in% c("G", "PG", "PG-13", "R")) %>%
mutate(decade = floor(year / 10) * 10) %>%
filter(decade >= 1940) %>%
group_by(decade, mpaa) %>%
summarise(count = n(), .groups = "drop")
# Ensure the MPAA levels are in a logical order for the plot legend
mpaa_trends$mpaa <- factor(mpaa_trends$mpaa, levels = c("G", "PG", "PG-13", "R"))
# Create the plot
ggplot(mpaa_trends, aes(x = factor(decade), y = count, fill = mpaa)) +
geom_col(position = "fill") +
scale_y_continuous(labels = percent) +
labs(
title = "Change in Proportion of MPAA Ratings by Decade",
x = "Decade",
y = "Percentage of Movies",
fill = "MPAA Rating"
) +
theme_minimal()
ggplot(mpaa_trends, aes(x = factor(decade), y = count, fill = mpaa)) +
geom_col(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Change in Proportion of MPAA Ratings by Decade",
x = "Decade",
y = "Percentage of Movies",
fill = "MPAA Rating"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
