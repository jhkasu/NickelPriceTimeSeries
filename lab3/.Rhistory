install.packages("shiny")
# 2. Server - Run calculations and generate plots/text
server <- function(input, output) {
# Set a consistent sample size for each simulation
n_per_group <- 100
# 1. Create a reactive data frame
# This code block will re-run automatically *only* when the sliders change.
reactive_data <- reactive({
# Generate random data for each group based on slider inputs
group_a <- rnorm(n_per_group, mean = input$mean_a, sd = input$sd_all)
group_b <- rnorm(n_per_group, mean = input$mean_b, sd = input$sd_all)
group_c <- rnorm(n_per_group, mean = input$mean_c, sd = input$sd_all)
# Combine data into a single data frame
data.frame(
values = c(group_a, group_b, group_c),
groups = factor(rep(c("Group A", "Group B", "Group C"), each = n_per_group))
)
})
# 2. Create a reactive block for the ANOVA test
# This also re-runs when sliders change, using the data from above
reactive_anova <- reactive({
# Run the ANOVA test on the generated data
# We use the reactive data by calling reactive_data()
aov_model <- aov(values ~ groups, data = reactive_data())
# Get the summary of the test
summary(aov_model)
})
# 3. Generate the box plot
# This function provides the plot to the 'plotOutput("boxplot")' in the UI
output$boxplot <- renderPlot({
# Get the data from our reactive block
plot_data <- reactive_data()
# Create the boxplot
boxplot(values ~ groups, data = plot_data,
main = "Box Plot of Group Distributions",
xlab = "Groups",
ylab = "Values",
col = c("lightblue", "lightgreen", "lightpink"))
})
# 4. Generate the p-value text output
output$p_value_text <- renderText({
# Get the ANOVA summary from our reactive block
aov_summary <- reactive_anova()
# Extract the p-value from the summary
# The structure is summary[[1]]$"Pr(>F)"[1]
p_value <- aov_summary[[1]]$`Pr(>F)`[1]
# Format and return the text
paste("ANOVA P-value:", format(p_value, digits = 4))
})
# 5. Generate the conclusion text output
output$conclusion_text <- renderText({
# Get the ANOVA summary again
aov_summary <- reactive_anova()
p_value <- aov_summary[[1]]$`Pr(>F)`[1]
# Check if the p-value is significant (typically < 0.05)
if (p_value < 0.05) {
"Conclusion: Statistically significant difference found between groups (p < 0.05)"
} else {
"Conclusion: No statistically significant difference found (p >= 0.05)"
}
})
}
